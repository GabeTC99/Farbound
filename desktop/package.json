{
  "name": "nullharbor",
  "version": "2.16.11",
  "private": true,
  "description": "Nullharbor Windows desktop shell — bundled dist/ plus HTTPS for optional cloud sync",
  "author": "Voidwake Studios",
  "main": "main.cjs",
  "productName": "Nullharbor",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^37.6.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nullharbor.game",
    "productName": "Nullharbor",
    "copyright": "Copyright Voidwake Studios",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "shell-policy.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nullharbor.exe"
    },
    "portable": {
      "artifactName": "Nullharbor.exe"
    }
  }
}
